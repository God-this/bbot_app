# RAGAS 캐시 품질 평가 배치 (③단계)
#
# 설치:
#   sudo cp backend/deploy/bebot-ragas.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now bebot-ragas.timer
#
# 주의: ragas는 서비스(bebot) venv에 설치되어 있지 않다. 이 유닛은
# ragas가 설치된 별도 venv를 가리켜야 한다 (아래 ExecStart 경로 확인).
# 수동 1회 실행: sudo systemctl start bebot-ragas.service

[Unit]
Description=BeBot RAGAS cache quality evaluation batch
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/bbot_app/backend
EnvironmentFile=/home/ubuntu/bbot_app/backend/.env

# --execute 없이 실행 = dry-run. 캐시를 건드리지 않고 점수만 수집한다.
# ④단계에서 threshold를 확정한 뒤에야 --execute를 붙일 것.
ExecStart=/home/ubuntu/ragas-venv/bin/python -m ragas_eval.runner --limit 200

# 배치가 LLM을 많이 부르므로 넉넉히 준다. 초과 시 중단되어도
# 큐는 Postgres에 남아 다음 회차로 이월된다.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
