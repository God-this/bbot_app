# ============================================================
# 스테이징(docker compose) 전용 환경변수 템플릿
#
# 사용법: cp backend/.env.staging.example backend/.env.staging 후 [필수] 값을 채운다
# - .env.staging은 git/Docker 이미지에서 제외됨 (.gitignore, .dockerignore의 .env.*)
# - 운영 DB(localhost:5433 터널, EC2 주소)를 절대 넣지 말 것
# - 따옴표 없이 KEY=value 형태로만 작성
# - 쓰지 않는 값은 빈 값으로 두지 말고 줄을 지운다
#   (빈 값이 코드 기본값을 덮어쓰거나 int("")로 기동이 실패함)
# - 예외: IMAGE_BASE_URL은 빈 값 유지 (줄을 지우면 운영 도메인이 쓰임)
# ============================================================

# ========== 모델 선택 ==========
# PROVIDER (openai / upstage / ollama)
# openai 외의 provider로 바꾸면 해당 키는 .env.example을 참고해 추가
PROVIDER=openai

# Embedding Provider (미설정시 PROVIDER와 동일한 값)
EMBED_PROVIDER=openai

# Judge
JUDGE_PROVIDER=openai
JUDGE_OPENAI_MODEL=gpt-5.4

# ========== API KEY ==========
# OPENAI
# [필수]
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ========== DB ==========
# compose의 postgres 서비스. 빈 volume으로 처음 기동할 때 이 값으로 DB와 계정이 만들어진다
# (이후 바꾸면 volume을 지우고 다시 만들어야 함)
DB_HOST=postgres
DB_NAME=bebot_openai2
DB_USER=bebot_user2
# [필수] 스테이징용으로 새로 생성 (예: openssl rand -hex 24). 운영 비밀번호 재사용 금지
DB_PASSWORD=
DB_PORT=5432

# ========== Redis ==========
# compose의 redis 서비스
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ========== YouTube ==========
# [선택] 영상 링크 상태 점검 (video_health_checker.py). 쓰지 않으면 줄을 지운다
YOUTUBE_API_KEY=

# ========== Book Images ==========
# 책 이미지 URL 앞부분 ({IMAGE_BASE_URL}/images/파일명)
# 이 줄을 지우면(미설정) 기본값 https://api.bebot.co.kr 사용 → 현재 운영(프론트/백엔드 도메인 분리)
# 빈 값이면 상대 경로 /images/... → 같은 도메인에서 경로로 라우팅하는 환경(compose nginx, CloudFront)
IMAGE_BASE_URL=

# ========== Social Login (Naver / Kakao) ==========
# [필수] 비어 있으면 해당 로그인이 500 오류
# 접속 주소를 각 개발자 콘솔에 등록해야 함 (STAGING_SOCIAL_LOGIN.md)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ========== Authentication ========
# [필수] 스테이징용으로 새로 생성 (예: openssl rand -hex 32)
# 빈 값이면 빈 문자열로 JWT를 서명하므로 반드시 채운다
JWT_SECRET_KEY=

# ========== Logging ==========
# docker compose logs -f backend 로 확인
# INFO / DEBUG
LOG_LEVEL=INFO

# ========== Hugging Face ========
# 리랭커 모델은 이미지에 포함되어 있으므로 실행 중 다운로드하지 않는다
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== Langfuse ========
# [선택] 운영 트레이스와 섞이지 않도록 스테이징용 프로젝트 키 사용. 쓰지 않으면 키 두 줄을 지운다
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=staging
