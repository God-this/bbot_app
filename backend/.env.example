# ========== 모델 선택 ==========
# PROVIDER (openai / upstage / ollama)
PROVIDER=

# Embedding Provider (미설정시 PROVIDER와 동일한 값)
EMBED_PROVIDER

# Judge
JUDGE_PROVIDER=

# Guardrail (입력 가드레일: 탈옥/주제 판단)
# openai / upstage — strict json_schema 지원 필요 (ollama는 모델마다 달라 비권장)
# 미설정 시 openai. 유해 콘텐츠 검사(moderations)는 이 설정과 무관하게 항상 OpenAI 사용
GUARDRAIL_PROVIDER=
GUARDRAIL_UPSTAGE_MODEL=
GUARDRAIL_OPENAI_MODEL=

# Document Judge (문서 충분성 판단) — 입력 가드레일과 독립 설정
# 미설정 시 openai. upstage(Solar)는 이 판정이 과하게 엄격해 비권장
DOC_JUDGE_PROVIDER=
DOC_JUDGE_UPSTAGE_MODEL=
DOC_JUDGE_OPENAI_MODEL=

# ollama (PROVIDER로 ollama 선택 시 - 모델 선택)
OLLAMA_LLM_MODEL=
OLLAMA_EMBED_MODEL=
JUDGE_OLLAMA_MODEL=
JUDGE_OLLAMA_BASE_URL=

# ========== API KEY ==========
# UPSTAGE
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=
UPSTAGE_LLM_MODEL=
UPSTAGE_EMBED_MODEL=
UPSTAGE_EMBED_BASE_URL=

# OPENAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# ========== DB ==========
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ========== LangSmith ==========
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# ========== Authentication ========
JWT_SECRET_KEY=
ADMIN_EMAILS=

# ========== Logging ==========
# journalctl -u bebot -f 로 실시간 확인
# 문제 발생 시 DEBUG로 변경 후 sudo systemctl restart bebot
# INFO / DEBUG
LOG_LEVEL=INFO

# ========== Hugging Face Token ========
HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== Langfuse ========
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ========== Naver Login ========
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ========== Kakao Login ========
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
