# ========== 모델 선택 ==========
# PROVIDER (openai / upstage / ollama)
PROVIDER=

# Embedding Provider (미설정시 PROVIDER와 동일한 값)
EMBED_PROVIDER=

# Judge
JUDGE_PROVIDER=
JUDGE_OPENAI_MODEL=
JUDGE_UPSTAGE_MODEL=

# ollama (PROVIDER로 ollama 선택 시 - 모델 선택)
OLLAMA_LLM_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_BASE_URL=
OLLAMA_EMBED_DIM=
JUDGE_OLLAMA_MODEL=
JUDGE_OLLAMA_BASE_URL=

# ========== API KEY ==========
# UPSTAGE
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=
UPSTAGE_LLM_MODEL=
UPSTAGE_EMBED_MODEL=
UPSTAGE_EMBED_BASE_URL=

# OPENAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# ========== DB ==========
# 220.149.110.152
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ========== Redis ==========
# 컨테이너 환경에서는 서비스 이름(예: redis)으로 지정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ========== YouTube ==========
# 영상 링크 상태 점검 (video_health_checker.py)
YOUTUBE_API_KEY=

# ========== Book Images ==========
# 책 이미지 URL 앞부분 ({IMAGE_BASE_URL}/images/파일명)
# 이 줄을 지우면(미설정) 기본값 https://api.bebot.co.kr 사용 → 현재 운영(프론트/백엔드 도메인 분리)
# 빈 값이면 상대 경로 /images/... → 같은 도메인에서 경로로 라우팅하는 환경(compose nginx, CloudFront)
IMAGE_BASE_URL=

# ========== Social Login (Naver / Kakao) ==========
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ========== Authentication ========
JWT_SECRET_KEY=
ADMIN_EMAILS=

# 게스트(비회원) 로그인 사용 여부 (true / false, 미설정 시 false)
# true면 로그인 화면에 "로그인 없이 질문하기" 버튼이 보이고 /api/auth/guest 사용 가능
# 변경 후 서버 재시작 필요 (sudo systemctl restart bebot.service). 프론트 재빌드는 불필요
GUEST_LOGIN=false

# ========== Logging ==========
# journalctl -u bebot -f 로 실시간 확인
# 문제 발생 시 DEBUG로 변경 후 sudo systemctl restart bebot
# INFO / DEBUG
LOG_LEVEL=INFO

# ========== Hugging Face Token ========
HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== Langfuse ========
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 로컬/운영 트레이스 구분 (Langfuse Environment 필터). 운영(EC2)은 production
LANGFUSE_TRACING_ENVIRONMENT=local