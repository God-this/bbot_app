# ========== 모델 선택 ==========
# PROVIDER (openai / upstage / ollama)
PROVIDER=

# Embedding Provider (미설정시 PROVIDER와 동일한 값)
EMBED_PROVIDER=

# Judge
JUDGE_PROVIDER=

# ollama (PROVIDER로 ollama 선택 시 - 모델 선택)
OLLAMA_LLM_MODEL=
OLLAMA_EMBED_MODEL=
JUDGE_OLLAMA_MODEL=
JUDGE_OLLAMA_BASE_URL=

# ========== API KEY ==========
# UPSTAGE
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=
UPSTAGE_LLM_MODEL=
UPSTAGE_EMBED_MODEL=
UPSTAGE_EMBED_BASE_URL=

# OPENAI
OPENAI_API_KEY=
OPENAI_LLM_MODEL=
OPENAI_EMBED_MODEL=

# ========== DB ==========
# 220.149.110.152
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=

# ========== Authentication ========
JWT_SECRET_KEY=
ADMIN_EMAILS=

# ========== Logging ==========
# journalctl -u bebot -f 로 실시간 확인
# 문제 발생 시 DEBUG로 변경 후 sudo systemctl restart bebot
# INFO / DEBUG
LOG_LEVEL=INFO

# ========== Hugging Face Token ========
HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== Langfuse ========
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 로컬/운영 트레이스 구분 (Langfuse Environment 필터). 운영(EC2)은 production
LANGFUSE_TRACING_ENVIRONMENT=local

# ========== 성경 구절 검증 ========
# bible_verify.py (코드로 원문 대조) / bible_verse_judge.py (맥락·주소 판정)
# code: 코드로 원문 대조(기본) / off: 검증 안 함
VERSE_VERIFY_MODE=code
# 주소만 언급된 3절 이하 구절의 원문을 답변 끝 '참고 구절'로 붙일지
APPEND_REFERENCE_VERSES=true
# 성경 인용 맥락·주소 판정 — code 방식 위에서 동작
# shadow: 응답 전송 후 판정해 기록만 남김(기본) / apply: 판정을 답변에 반영 / off: 끔
VERSE_JUDGE_MODE=shadow
# 맥락이 안 맞는 인용 처리 — log: 기록만(기본) / remove: 답변에서 지움 (apply일 때)
VERSE_CONTEXT_ACTION=log
# 성경 원문 출처 — db: 운영 DB bible_krv(기본, 실패 시 bible.txt) / file: bible.txt만 (테스트용)
BIBLE_SOURCE=db
